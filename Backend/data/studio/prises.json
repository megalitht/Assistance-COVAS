  "data/son/Conversations/Initiatives/Rachat1.mp3": {
    "texte": "Nouveau vaisseau, même commandant. Essayons de garder celui-ci un peu plus longtemps.",
    "date": "2026-11-22T20:37:52",
    "parole": 5.75,
